{
  "name": "eslsca-4chan-scraper",
  "version": "1.0.0",
  "description": "4chan multi-board scraper for ESLSCA research project",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:snapshot": "tsx src/index.ts --mode snapshot",
    "start:monitor": "tsx src/index.ts --mode monitor",
    "scrape:pol": "tsx src/index.ts --mode snapshot --board pol",
    "scrape:x": "tsx src/index.ts --mode snapshot --board x",
    "monitor:pol": "tsx src/index.ts --mode monitor --board pol",
    "monitor:x": "tsx src/index.ts --mode monitor --board x"
  },
  "keywords": [
    "4chan",
    "scraper",
    "research"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "csv-writer": "^1.6.0",
    "he": "^1.2.0",
    "p-queue": "^8.0.1"
  }
}
